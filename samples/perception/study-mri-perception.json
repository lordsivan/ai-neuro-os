      "asserted_by": "algorithm", "timestamp": "2026-01-02"
    },
    {
      "id": "det-dwi", "modelRunId": "run-dwi-restrict", "source": "image",
      "kind": "rim diffusion restriction",
      "attributes": { "diffusionRestriction": "rim" },
