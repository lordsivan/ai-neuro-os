    { "id": "run-measure", "server": "measurement", "model": "voltool", "modelVersion": "3.0", "inputRef": "ser-mri-flair", "qc": "pass", "status": "ok" },
    { "id": "run-report", "server": "report-nlp", "model": "radnlp", "modelVersion": "2.0", "inputRef": "report-mri-001", "qc": "pass", "status": "ok" }
